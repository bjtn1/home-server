# for the thinkpad
syncthing.bjtn.xyz {
  import porkbun_tls
  import authelia
  reverse_proxy syncthing:8384 {
    # we need this because otherwise we'll get a "host check error"
    header_up Host {upstream_hostport}
  }
}

