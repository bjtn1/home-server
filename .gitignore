# ignore everything by default
*
# but let git look inside directories
!*/
# only these files are ever tracked, no matter where they live
!docker-compose.yml
!docker-compose.yaml
!Caddyfile
!/.gitignore
!.env.example
# wger's nginx/redis config (plain, no secrets)
!nginx.conf
!redis.conf
# scrutiny's per-device smartctl overrides (plain, no secrets)
!collector.yaml
# samba's macOS-compat override (plain, no secrets)
!smb.conf
# downloads-control's and arr-control's app source (plain Python +
# Dockerfile, no secrets -- those live in each app's .env, already
# excluded by the default-deny rule above)
!app.py
!Dockerfile
# bjtn's cron scripts, moved into docker/scripts/ 2026-09-01 for git
# tracking (plain bash, no secrets -- passwords come from
# RESTIC_PASSWORD_FILE/container env vars, not literals; verified clean
# via gitleaks)
!backup.sh
!ssd-backup.sh
!update-pi.sh
!supernote-pdf-sync.sh
# Web-button trigger for supernote-pdf-sync.sh -- runs on the host (not
# containerized) as a systemd --user service, since the sync script needs
# real Docker daemon access (docker exec into nextcloud), 2026-09-04
!supernote-control.py
# Web-button trigger for ssd-backup.sh -- also runs on the host (not
# containerized), reusing the host's broad /mnt/vault + /mnt/games +
# backup-SSD access and already-configured restic install rather than
# replicating all of that into a new container, 2026-09-04
!backup-control.py
# root/systemd-managed scripts, moved from /usr/local/bin + /etc into
# docker/scripts/ 2026-09-02 for git tracking (plain bash/python + one
# config file, nothing sensitive in either)
!arr-cutoff-search.sh
!sabnzbd-orphan-cleanup.py
!disk-io-watchdog.sh
!disk-io-watchdog-resolved.sh
!disk-io-watchdog.conf
# Per-show/movie granular restic backup provisioning for /tv + /movies
# (now the manually-curated Castilian-only library) -- run on demand via
# the Jenkins "media-backup-provision" job. Replaces castilian-scan.py
# (retired 2026-09-18: its purpose, finding non-Castilian audio, is moot
# once /tv is manually-verified before anything enters it). No API keys
# needed -- pure filesystem + restic, no Sonarr/Radarr calls.
!media-backup-provision.py
# Castilian subtitle generation via the whisper.cpp server (see
# scripts/whisper-subtitle-plan.md): shared modules + read-only scan + generator.
# No secrets; server URL comes from WHISPER_SERVER_URL / a public default.
!whisper_client.py
!whisper_media.py
!whisper_srt.py
!whisper-scan.py
!whisper-generate.py
!whisper-glossary.py
!whisper-vocab.py
# Regression tests for the whisper SRT cleaner/name-correction (fixtures = real failures seen on cartoon output)
!test_whisper_srt.py
# Subtitle readability (reflow/wrap/split, "Castilian" title via <video>.es.Castilian.srt) lives in whisper_srt.py + tests above.
# Baked-in side-bar detection + fix for "fake 16:9" (4:3 picture pillarboxed inside a 16:9 frame, e.g. Sargento Keroro):
# read-only detector + in-place crop/stretch fixer with per-file geometry + output verification.
!detect-pillarbox.py
!depillarbox.py
# Speech-chunked transcription: Silero VAD (CPU, isolated venv ~/venvs/vad) finds real speech; whisper only sees speech
# packed into <=27 s windows and timestamps are mapped back, fixing cues placed tens of seconds early/late after silences.
!speech_vad.py
!whisper_chunks.py
# castilianize baked-in side-bar detection+fix: real-ffmpeg end-to-end tests on synthetic videos (~1 min)
!test_castilianize_bars.py
!test_whisper_chunks.py
# In-place library normalizer for the Castilian library (stretch 4:3->16:9, remux to mkv,
# tag ONLY the Castilian audio track) -- Jenkins job "castilianize", dry-run by default.
!castilianize.py
# One-shot relabel of legacy mis-tagged (spa) audio tracks by track NAME; dry-run default -- pc-claude's script,
# adapted with a recent-file guard.
!relabel_audio.py
# Immich OBS-album membership sync, bjtn crontab (2026-09-02). API key is
# NOT in this file -- passed inline via crontab's env prefix, same
# treatment as the Sonarr/Radarr keys in arr-cutoff-search.sh's history.
!obs-album-sync.py
# Rescans Nextcloud's file-cache index against the real filesystem for
# bjtn (occ files:scan), triggered by the new nextcloud-files-scan Jenkins
# job. No secrets -- talks to the nextcloud container via `docker exec`,
# no API key needed (2026-09-10).
!nextcloud-files-scan.sh
!/.gitleaks.toml
!/.gitleaks-baseline.json
!/.githooks/
!/.githooks/**
