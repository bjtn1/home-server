# ignore everything by default
*
# but let git look inside directories
!*/
# only these files are ever tracked, no matter where they live
!docker-compose.yml
!docker-compose.yaml
!Caddyfile
!/.gitignore
!.env.example
# wger's nginx/redis config (plain, no secrets)
!nginx.conf
!redis.conf
# scrutiny's per-device smartctl overrides (plain, no secrets)
!collector.yaml
# samba's macOS-compat override (plain, no secrets)
!smb.conf
# downloads-control's and arr-control's app source (plain Python +
# Dockerfile, no secrets -- those live in each app's .env, already
# excluded by the default-deny rule above)
!app.py
!Dockerfile
# bjtn's cron scripts, moved into docker/scripts/ 2026-09-01 for git
# tracking (plain bash, no secrets -- passwords come from
# RESTIC_PASSWORD_FILE/container env vars, not literals; verified clean
# via gitleaks)
!backup.sh
!ssd-backup.sh
!update-pi.sh
!supernote-pdf-sync.sh
# Web-button trigger for supernote-pdf-sync.sh -- runs on the host (not
# containerized) as a systemd --user service, since the sync script needs
# real Docker daemon access (docker exec into nextcloud), 2026-09-04
!supernote-control.py
# Web-button trigger for ssd-backup.sh -- also runs on the host (not
# containerized), reusing the host's broad /mnt/vault + /mnt/games +
# backup-SSD access and already-configured restic install rather than
# replicating all of that into a new container, 2026-09-04
!backup-control.py
# root/systemd-managed scripts, moved from /usr/local/bin + /etc into
# docker/scripts/ 2026-09-02 for git tracking (plain bash/python + one
# config file; the config's Kuma push URL is a semi-sensitive token, not
# a real secret, and matches the same tolerance already accepted for the
# push URLs embedded directly in backup.sh/ssd-backup.sh/etc above)
!arr-cutoff-search.sh
!sabnzbd-orphan-cleanup.py
!disk-io-watchdog.sh
!disk-io-watchdog-resolved.sh
!disk-io-watchdog.conf
# Sonarr/Radarr On Import custom script -- flags Latin-American/neutral
# Spanish audio tracks that slip past the release-title-only custom format,
# 2026-09-03
!arr-audio-lang-check.sh
# Muxes a Castilian Spanish audio track from a separately-downloaded release
# into existing library files in place, 2026-09-03
!mux-castilian-audio.sh
# Work queue for pulling Castilian releases from MEGA and handing them off
# to mux-castilian-audio.sh, 2026-09-03
!castilian-queue.sh
# Shared LATAM_PATTERN/CASTILIAN_PATTERN constants, sourced by the three
# scripts above so they can't drift out of sync with each other, 2026-09-04
!castilian-patterns.sh
# Archives Castilian audio tracks out of library files into a standalone,
# restic-backed audio-only archive so they never have to be re-hunted from
# MEGA if a library file is ever replaced, 2026-09-04
!archive-castilian-audio.sh
# Drop-folder auto-pipeline: scans a drop zone, detects/extracts genuinely
# Castilian tracks, matches them to owned Sonarr/Radarr library items via
# live lookup, and hands off to castilian-queue.sh -- 2026-09-04
!castilian-drop-scan.sh
# Read-only audit: reports every show/movie in the library still missing
# Castilian audio on some or all of its files -- 2026-09-04
!castilian-coverage-report.sh
# Whisper-transcript-based Castilian/Latin-American classifier -- the
# content-based fallback for files whose metadata gives no dialect signal
# at all (the "und" + generic "[Spa]" title case). Three pieces: extracts
# a clip (local ffmpeg), transcribes it (remote whisper-server over
# Tailscale), classifies the transcript via grammar/vocabulary markers
# (local, free) -- 2026-09-08
!castilian-speech-patterns.sh
!castilian-extract-clip.sh
!castilian-linguistic-classify.sh
!castilian-whisper-check.sh
# Verified duration-mismatch alignment engine (English-track correlation
# via numpy FFT, black-frame fallback, silence-snapped correction) --
# 2026-09-09. No secrets (WHISPER_SERVER_URL defaults to an internal
# Tailscale-only address, not reachable outside the tailnet).
!castilian-audio-align.py
# Content-verified episode re-matcher -- built the same night episode-
# number matching turned out unreliable for shows with regional dub-
# numbering divergence (Courage the Cowardly Dog: DVD order, not aired
# order). Imports castilian-audio-align.py directly rather than
# duplicating its correlation/transcript logic. SONARR_URL/SONARR_KEY
# read from environment, no secrets in the file itself -- 2026-09-10.
!castilian-episode-match.py
# Hand-verified Spanish-dub-numbering -> aired-episode-numbering map for
# Courage the Cowardly Dog, built from TheTVDB's public "Alternate DVD
# Order" pages (no login/API key needed) and confirmed against real
# audio/transcript content across all 4 seasons -- pure data, no
# secrets, 2026-09-10.
!castilian-dvd-order-map.json
# Immich OBS-album membership sync, bjtn crontab (2026-09-02). API key is
# NOT in this file -- passed inline via crontab's env prefix, same
# treatment as the Sonarr/Radarr keys in arr-cutoff-search.sh's history.
!obs-album-sync.py
# Rescans Nextcloud's file-cache index against the real filesystem for
# bjtn (occ files:scan), triggered by the new nextcloud-files-scan Jenkins
# job. No secrets -- talks to the nextcloud container via `docker exec`,
# no API key needed (2026-09-10).
!nextcloud-files-scan.sh
!/.gitleaks.toml
!/.gitleaks-baseline.json
!/.githooks/
!/.githooks/**
