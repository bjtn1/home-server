################### SYNCTHING ##########################
########################################################

syncthing.bjtn.xyz {
  import porkbun_tls
  reverse_proxy syncthing:8384 {
    # we need this because otherwise we'll get a "host check error"
    header_up Host {upstream_hostport}
  }
}

