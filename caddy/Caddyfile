{
  # HTTP/2 doesn't support the classic Upgrade: websocket mechanism (only
  # RFC8441 Extended CONNECT, which most WebSocket client libraries -- e.g.
  # the ntfy mobile app -- don't implement). Global HTTP/1.1-only avoids
  # WebSocket connections silently failing on any self-hosted app. No real
  # downside on a lightly-trafficked homelab.
  servers {
    protocols h1
  }
}

# this is the DNS stuff we need for every entry
(porkbun_tls) {
  tls {
    dns porkbun {
      api_key {env.PORKBUN_API_KEY}
      api_secret_key {env.PORKBUN_API_SECRET_KEY}
    }
  }
}

# gate: forwards every request to Authelia first. default_policy: deny in
# authelia/config/access.yml means nothing behind this is reachable by anyone not
# explicitly granted -- imported into every site block below, including this file's own
# admin/control-panel entries. auth.bjtn.xyz itself (the login portal) must NEVER import
# this, or it becomes an infinite redirect loop.
(authelia) {
  forward_auth authelia:9091 {
    uri /api/verify?rd=https://auth.bjtn.xyz
    copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
  }
}

########################################################
################### AUTHELIA ############################
########################################################

# the login portal itself -- NOT gated (see the snippet's comment above)
auth.bjtn.xyz {
  import porkbun_tls
  reverse_proxy authelia:9091
}

# who-can-reach-what control panel -- bjtn only (see authelia/config/access.yml)
access.bjtn.xyz {
  import porkbun_tls
  import authelia
  reverse_proxy access-control:8770
}

########################################################
################### PIHOLE #############################
########################################################

# for pihole
pihole.bjtn.xyz,
pi.bjtn.xyz {
  import porkbun_tls
  # route{} forces written order -- Caddy's DEFAULT directive order runs redir before
  # forward_auth (confirmed against Caddy's own docs), so without this the redirect to
  # /admin/ fired before the auth check ever ran, letting anyone straight into Pi-hole's
  # admin UI. This is the only block in this file combining forward_auth with a directive
  # that has a default order ahead of it -- every other block is a bare reverse_proxy,
  # which forward_auth already precedes by default (verified live for all of them).
  route {
    import authelia
    redir / /admin/
    reverse_proxy pihole:80
  }
}

