# Copy this to .env and fill in real values. .env is gitignored; this file
# (with placeholders only) is the one that gets committed.

# Where Nextcloud stores user files. Network shares work here (unlike
# Postgres's data dir) but keep it off anything you'd mind losing.
NEXTCLOUD_DATA_DIR=/mnt/vault/nextcloud

# Postgres connection secret. Use only A-Za-z0-9 to dodge any shell/env
# quoting issues.
POSTGRES_PASSWORD=changeme

# Redis auth password.
REDIS_PASSWORD=changeme

# Admin account created automatically on first boot. If you'd rather use the
# web setup wizard instead, leave these two blank.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

# Space-separated (not comma-separated!) list of hostnames Nextcloud will
# answer requests for. The entrypoint script splits on whitespace, so a
# comma-joined value gets stored as one single (wrong) trusted domain --
# ask us how we know. No scheme, no trailing slash.
NEXTCLOUD_TRUSTED_DOMAINS=cloud.bjtn.xyz nc.bjtn.xyz nextcloud.bjtn.xyz

# CIDR/IP of whatever proxies to this container -- Caddy sits on the same
# bjtn-proxy docker network, so this is that network's subnet, not a single
# host IP. Check with: docker network inspect bjtn-proxy | grep Subnet
TRUSTED_PROXIES=172.18.0.0/16
